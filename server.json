    {
      "type": "streamable-http",
      "url": "https://mcp.flowmingo.ai/mcp",
      "headers": [
        {
          "name": "x-api-key",
          "description": "Your Flowmingo API key",
          "isRequired": true,
          "isSecret": true
        }
      ]
    }
  ]
}