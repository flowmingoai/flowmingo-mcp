{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "ai.flowmingo/flowmingo",
  "description": "Free AI hiring platform: create AI interview sets, invite candidates, read scored reports.",
  "version": "1.0.0",
  "websiteUrl": "https://flowmingo.ai/integration/mcp",
