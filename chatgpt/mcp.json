{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "flowmingo": {
      "type": "streamable-http",
      "url": "https://mcp.flowmingo.ai/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": { "mode": "dcr" },
            "defaultScopes": ["read_hiring", "read_candidates", "write_pipeline", "invite_candidates"]
          }
        }
      }
    }
  }
}
